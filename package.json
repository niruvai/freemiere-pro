{
  "name": "freemiere-pro",
  "productName": "Freemiere Pro",
  "version": "2.2.0",
  "description": "Freemiere Pro \u2014 a Premiere-style video editor for macOS, built on Electron and FFmpeg",
  "main": "src/main.js",
  "author": "Nurunnabi Islam",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "start": "node scripts/setup.js --quiet && electron .",
    "dist": "node scripts/setup.js --quiet && electron-builder --mac",
    "dist:dir": "node scripts/setup.js --quiet && electron-builder --mac --dir"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freemierepro.editor",
    "productName": "Freemiere Pro",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "fileAssociations": [
      {
        "ext": "fpproj",
        "name": "Freemiere Pro Project",
        "role": "Editor"
      },
      {
        "ext": "flproj",
        "name": "Freemiere Pro Project (old)",
        "role": "Editor"
      }
    ]
  }
}
