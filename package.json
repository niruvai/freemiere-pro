{
  "name": "freemiere-pro",
  "productName": "Freemiere Pro",
  "version": "2.3.0",
  "description": "Freemiere Pro \u2014 a Premiere-style video editor for macOS, built on Electron and FFmpeg",
  "main": "src/main.js",
  "author": "Nurunnabi Islam",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "start": "node scripts/setup.js --quiet && electron .",
    "dist": "node scripts/setup.js --quiet && electron-builder --mac --publish never",
    "dist:dir": "node scripts/setup.js --quiet && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freemierepro.editor",
    "productName": "Freemiere Pro",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "minimumSystemVersion": "11.0"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "fileAssociations": [
      {
        "ext": "fpproj",
        "name": "Freemiere Pro Project",
        "role": "Editor"
      },
      {
        "ext": "flproj",
        "name": "Freemiere Pro Project (old)",
        "role": "Editor"
      }
    ],
    "artifactName": "Freemiere-Pro-${arch}.${ext}",
    "dmg": {
      "title": "Freemiere Pro ${version}"
    },
    "afterPack": "build/afterPack.js"
  },
  "homepage": "https://github.com/niruvai/freemiere-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/niruvai/freemiere-pro.git"
  },
  "bugs": {
    "url": "https://github.com/niruvai/freemiere-pro/issues"
  }
}
