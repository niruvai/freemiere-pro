{
  "name": "frameline",
  "productName": "Frameline",
  "version": "1.0.0",
  "description": "A Premiere-style video editor for macOS, built on Electron and FFmpeg",
  "main": "src/main.js",
  "author": "Nurunnabi Islam",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac --dir"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.frameline.editor",
    "productName": "Frameline",
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg"],
      "icon": "build/icon.png"
    },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/@ffprobe-installer/**"],
    "fileAssociations": [{ "ext": "flproj", "name": "Frameline Project", "role": "Editor" }]
  }
}
